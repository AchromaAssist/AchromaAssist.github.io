---
// Everyday objects rendered in grayscale with AR-style color labels.
// Red/green and orange/blue are paired with near-equal lightness on purpose:
// in grayscale they become hard to tell apart, which is the whole point.
const swatches = [
  { name: 'Red', hex: '#c9433a', object: 'Stop light' },
  { name: 'Green', hex: '#3f8f45', object: 'Go light' },
  { name: 'Yellow', hex: '#e7c23d', object: 'Banana' },
  { name: 'Orange', hex: '#df7a2a', object: 'Tangerine' },
  { name: 'Blue', hex: '#2f6fd0', object: 'Jeans' },
  { name: 'Purple', hex: '#8650c4', object: 'Grapes' },
];
---

<figure class="demo" data-swatch-demo>
  <div class="frame">
    <span class="corner tl" aria-hidden="true"></span>
    <span class="corner tr" aria-hidden="true"></span>
    <span class="corner bl" aria-hidden="true"></span>
    <span class="corner br" aria-hidden="true"></span>
    <ul class="grid">
      {
        swatches.map((s) => (
          <li>
            <span class="tile" style={`--c:${s.hex}`} />
            <span class="label">
              <b>{s.name.toUpperCase()}</b>
              <span>{s.object}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
  <figcaption>
    <p>
      With achromatopsia the world looks like this: shades of gray. AchromaAssist adds the missing
      color as a label.
    </p>
    <button type="button" class="toggle" aria-pressed="false">
      <span class="dot" aria-hidden="true"></span>
      <span class="txt">Show real colors</span>
    </button>
  </figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-swatch-demo]').forEach((demo) => {
    const btn = demo.querySelector<HTMLButtonElement>('.toggle');
    const txt = demo.querySelector<HTMLElement>('.toggle .txt');
    btn?.addEventListener('click', () => {
      const on = btn.getAttribute('aria-pressed') !== 'true';
      btn.setAttribute('aria-pressed', String(on));
      demo.classList.toggle('in-color', on);
      if (txt) txt.textContent = on ? 'Show in grayscale' : 'Show real colors';
    });
  });
</script>

<style>
  .demo {
    margin: 0;
    display: grid;
    gap: 18px;
  }
  .frame {
    position: relative;
    padding: 22px;
    background: var(--bg);
    border: 1.5px solid var(--line);
    border-radius: var(--radius);
  }
  .corner {
    position: absolute;
    width: 18px;
    height: 18px;
    border: 2px solid var(--hud);
  }
  .tl {
    top: 8px;
    left: 8px;
    border-right: 0;
    border-bottom: 0;
  }
  .tr {
    top: 8px;
    right: 8px;
    border-left: 0;
    border-bottom: 0;
  }
  .bl {
    bottom: 8px;
    left: 8px;
    border-right: 0;
    border-top: 0;
  }
  .br {
    bottom: 8px;
    right: 8px;
    border-left: 0;
    border-top: 0;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }
  li {
    position: relative;
    aspect-ratio: 1;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .tile {
    position: absolute;
    inset: 0;
    background: var(--c);
    filter: grayscale(1);
    transition: filter 0.6s ease;
  }
  .in-color .tile {
    filter: none;
  }
  .label {
    position: absolute;
    left: 8px;
    bottom: 8px;
    right: 8px;
    display: grid;
    gap: 2px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.3;
    color: #fff;
  }
  .label b {
    justify-self: start;
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    padding: 3px 6px;
    background: rgb(0 0 0 / 0.72);
    border: 1px solid #9be38a;
    color: #9be38a;
    border-radius: 3px;
  }
  .label span {
    justify-self: start;
    padding: 1px 6px;
    background: #000;
    border-radius: 3px;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
    color: var(--fg);
    font-size: 1rem;
  }
  figcaption p {
    flex: 1 1 240px;
  }
  .toggle {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1.5px solid var(--line);
    background: transparent;
    color: var(--fg);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .toggle:hover {
    border-color: var(--fg);
  }
  .dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: conic-gradient(#c9433a, #e7c23d, #3f8f45, #2f6fd0, #8650c4, #c9433a);
    filter: grayscale(1);
    transition: filter 0.3s;
  }
  .toggle[aria-pressed='true'] .dot {
    filter: none;
  }
  @media (max-width: 420px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
