---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SITE } from '../site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/#challenge', label: 'Challenge' },
  { href: '/#roadmap', label: 'Roadmap' },
  { href: '/prototypes', label: 'Prototypes' },
  { href: '/#get-involved', label: 'Get involved' },
];
---

<header class="site-header">
  <div class="container bar">
    <a href="/" class="brand" aria-label={`${SITE.name} home`}>
      <Logo size={44} />
      <span>Achroma<b>Assist</b></span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={SITE.github} class="gh" aria-label="AchromaAssist on GitHub">
            <Icon name="github" />
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 68px;
    flex-wrap: wrap;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    font-weight: 500;
    font-size: 1.125rem;
    letter-spacing: -0.01em;
  }
  .brand b {
    font-weight: 750;
  }
  ul {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 12px;
    border-radius: 999px;
    font-size: 1rem;
    color: var(--fg);
    text-decoration: none;
  }
  nav a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  nav a[aria-current='page'] {
    background: var(--fg);
    color: var(--bg);
    font-weight: 600;
  }
  .gh :global(svg) {
    width: 20px;
    height: 20px;
  }

  @media (max-width: 760px) {
    .bar {
      padding-block: 10px;
    }
    nav {
      overflow-x: auto;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: calc(var(--gutter) - 12px);
      width: calc(100% + 2 * var(--gutter));
      scrollbar-width: none;
    }
    nav::-webkit-scrollbar {
      display: none;
    }
    ul {
      width: max-content;
    }
  }
</style>
